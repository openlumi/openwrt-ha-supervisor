#!/bin/sh /etc/rc.common
# Starts HA Core container at boot (after dockerd) and the loopback-only API.
START=99
USE_PROCD=1

start_service() {
	mkdir -p /var/run/ha-supervisor
	local port
	port="$(uci -q get ha-supervisor.main.port)"; port="${port:-8124}"

	# 172.30.32.2 is where add-ons expect the Supervisor (many accept requests only from it, and
	# the ingress proxy uses it as its source address). A local address on lo is enough: replies
	# from a container are routed back to the host, which owns it.
	local sup
	sup="$(uci -q get ha-supervisor.main.supervisor_ip)"; sup="${sup:-172.30.32.2}"
	ip -4 addr show dev lo | grep -q " $sup/" || ip addr add "$sup/32" dev lo

	procd_open_instance ensure
	procd_set_param command /usr/sbin/ha-supervisor ensure
	procd_set_param stderr 1   # failures only; success prints nothing
	# one-shot: NO respawn (a respawning ensure re-ran every few seconds and hammered docker)
	procd_close_instance

	procd_open_instance api
	procd_set_param command /usr/bin/socat -t0.1 \
		"TCP-LISTEN:$port,bind=127.0.0.1,reuseaddr,fork" \
		"EXEC:/usr/sbin/ha-supervisor-http"
	procd_set_param respawn
	procd_close_instance

	# same API on the docker bridge gateway, for add-on containers (token-restricted)
	local bridge
	bridge="$(uci -q get ha-supervisor.main.bridge_ip)"; bridge="${bridge:-172.17.0.1}"
	procd_open_instance api_bridge
	procd_set_param command /usr/bin/socat -t0.1 \
		"TCP-LISTEN:$port,bind=$bridge,reuseaddr,fork" \
		"EXEC:/usr/sbin/ha-supervisor-http"
	procd_set_param respawn
	procd_close_instance
}
