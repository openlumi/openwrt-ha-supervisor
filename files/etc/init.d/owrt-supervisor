#!/bin/sh /etc/rc.common
# Starts HA Core container at boot (after dockerd) and the loopback-only API.
START=99
USE_PROCD=1

start_service() {
	mkdir -p /var/run/owrt-supervisor
	local port
	port="$(uci -q get owrt-supervisor.main.port)"; port="${port:-8124}"

	procd_open_instance ensure
	procd_set_param command /usr/sbin/owrt-supervisor ensure
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 0 5 3   # retry a few times if dockerd is not ready yet
	procd_close_instance

	procd_open_instance api
	procd_set_param command /usr/bin/socat -t0.1 \
		"TCP-LISTEN:$port,bind=127.0.0.1,reuseaddr,fork" \
		"EXEC:/usr/sbin/owrt-supervisor-http"
	procd_set_param respawn
	procd_close_instance
}
