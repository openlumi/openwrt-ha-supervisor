config supervisor 'main'
	# arch, image and catalog are written here when the package is installed (from uname -m):
	#   aarch64/amd64: image 'ghcr.io/home-assistant/home-assistant' (official)
	#   armv7:         image 'ghcr.io/adyoull/ha-armv7' (community build, upstream dropped armv7)
	# Edit them freely; an installed package only fills in options that are missing.
	option container 'homeassistant'
	option config_dir '/etc/homeassistant'
	# option timezone 'Europe/Moscow'   # default: the system time zone
	option port '8124'
	option channel 'stable'
	option backup_before_update '0'
	# list devices '/dev/ttyUSB0'
