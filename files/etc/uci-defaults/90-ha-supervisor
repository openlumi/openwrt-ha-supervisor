#!/bin/sh
# One-time migration from the former name (owrt-supervisor, development builds): keep the
# config (its token is already known to the Home Assistant container) and the add-on state.
if [ -f /etc/config/owrt-supervisor ]; then
	cp /etc/config/owrt-supervisor /etc/config/ha-supervisor && rm -f /etc/config/owrt-supervisor
fi
if [ -d /etc/owrt-supervisor ] && [ ! -e /etc/ha-supervisor ]; then
	mv /etc/owrt-supervisor /etc/ha-supervisor
fi

# Generate the API token once. (Enabling/starting the service is done by the package hook.)
[ -n "$(uci -q get ha-supervisor.main.token)" ] || {
	uci set ha-supervisor.main.token="$(head -c 24 /dev/urandom | hexdump -v -e '/1 "%02x"')"
	uci commit ha-supervisor
}
# make the architecture, the Home Assistant image and the add-on catalog explicit in the config
/usr/sbin/ha-supervisor init-config
exit 0
