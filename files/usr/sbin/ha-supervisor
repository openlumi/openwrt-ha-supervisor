#!/usr/bin/ucode -S
'use strict';
import * as core from 'supervisor.core';
import * as jobs from 'supervisor.jobs';
import * as cfgm from 'supervisor.config';
import * as registry from 'supervisor.registry';
import * as addons from 'supervisor.addons';

let args = [...ARGV];
let job;
let ji = index(args, '--job');
if (ji >= 0) {
	job = args[ji + 1];
	splice(args, ji, 2);
}
let cmd = shift(args);

function out(v) { print(type(v) == 'string' ? v + '\n' : sprintf('%.2J\n', v)); }

switch (cmd) {
case 'status':
	out(core.info(null, false));
	break;
case 'check':
	out(core.info(null, true));
	break;
case 'update': {
	// ha-supervisor update [tag] [--backup|--no-backup]
	let backup = null;
	let bi = index(args, '--backup');
	if (bi >= 0) { backup = true; splice(args, bi, 1); }
	bi = index(args, '--no-backup');
	if (bi >= 0) { backup = false; splice(args, bi, 1); }
	let r = core.update(args[0], job, backup);
	out(r);
	exit(r.ok ? 0 : 1);
}
case 'ensure': {
	// boot-time helper: silent on success, error only on stderr (goes to syslog via procd)
	let r = core.ensure();
	if (!r.ok) {
		warn(sprintf('ensure failed: %s\n', r.error ?? 'unknown'));
		exit(1);
	}
	break;
}
case 'start':   out({ ok: core.start() }); break;
case 'stop':    out({ ok: core.stop() }); break;
case 'restart': out({ ok: core.restart() }); break;
case 'logs':    print(core.logs(+(args[0] ?? 200))); break;
case 'panel-push': {
	// tell HA to re-read /ingress/panels for one add-on (retries while HA is starting)
	for (let i = 0; i < 20; i++) {
		if (addons.panel_push(args[0])) exit(0);
		system('sleep 15');
	}
	warn('panel-push: HA did not accept the notification\n');
	exit(1);
}
case 'discovery-push': {
	// HA may still be starting: retry for a few minutes
	for (let i = 0; i < 20; i++) {
		if (addons.discovery_push(args[0])) { out({ ok: true }); exit(0); }
		system('sleep 15');
	}
	warn('discovery-push: HA did not accept the notification\n');
	exit(1);
}
case 'addons':
	out(addons.installed_list(cfgm.load()));
	break;
case 'addon-install': {
	let r = addons.install(args[0], job);
	out(r);
	exit(r.ok ? 0 : 1);
}
case 'addon-uninstall':
	out(addons.uninstall(args[0]));
	break;
case 'addon-start':   out({ ok: addons.start(args[0]) }); break;
case 'addon-stop':    out({ ok: addons.stop(args[0]) }); break;
case 'addon-restart': out({ ok: addons.restart(args[0]) }); break;
case 'addon-logs':    print(addons.logs(args[0], +(args[1] ?? 200))); break;
case 'addon-options':
	// ha-supervisor addon-options <slug> '<json>'   (omit json to print current options)
	if (args[1] == null) {
		out(addons.options(args[0]) ?? 'not installed');
	} else {
		let o;
		try { o = json(args[1]); } catch (e) { o = null; }
		if (type(o) != 'object') { warn('options must be a JSON object\n'); exit(2); }
		out({ ok: addons.set_options(args[0], o) });
	}
	break;
case 'init-config': {
	// run by uci-defaults on install/upgrade: make arch, image and catalog explicit in UCI
	for (let w in cfgm.init_defaults())
		print(`ha-supervisor: set ${w}\n`);
	if (!cfgm.load().image)
		warn(`ha-supervisor: no Home Assistant image for architecture "${cfgm.load().arch}"; set 'option image' in /etc/config/ha-supervisor\n`);
	break;
}
case 'tags': {
	let c = registry.check(cfgm.load(), true);
	out(c ?? 'registry unreachable');
	break;
}
case 'set-source':
	// ha-supervisor set-source ghcr.io/adyoull/ha-armv7
	cfgm.set('image', args[0]);
	out({ image: args[0] });
	break;
default:
	warn('usage: ha-supervisor status|check|update [tag]|ensure|start|stop|restart|logs [n]|tags|set-source <image>|init-config\n       ha-supervisor addons|addon-install|addon-uninstall|addon-start|addon-stop|addon-restart|addon-logs|addon-options <slug> [json]\n');
	exit(2);
}
